{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Version floors: consumers must meet these, so they change by hand, never by bot.",
      "matchPackageNames": [
        "androidx.compose:compose-bom",
        "org.jetbrains.kotlin.**",
        "com.android.tools.build:gradle",
        "com.android.application",
        "com.android.library"
      ],
      "enabled": false
    }
  ]
}
