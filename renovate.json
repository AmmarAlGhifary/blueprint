{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "develop"
  ],
  "packageRules": [
    {
      "description": "Version floors: consumers must meet these, so they change by hand, never by bot.",
      "matchPackageNames": [
        "androidx.compose:compose-bom",
        "org.jetbrains.kotlin.**",
        "org.jetbrains.kotlin:**",
        "com.android.tools.build:gradle",
        "com.android.application**",
        "com.android.library**",
        "com.android.kotlin.multiplatform.library**"
      ],
      "enabled": false
    },
    {
      "description": "Toolchain floors: merge by hand only after checking AGP/Kotlin compatibility.",
      "matchPackageNames": [
        "gradle",
        "org.jetbrains.compose**",
        "org.jetbrains.kotlinx:kotlinx-serialization**"
      ],
      "groupName": "toolchain",
      "addLabels": [
        "toolchain-floor"
      ]
    },
    {
      "description": "The test-only Compose BOM (composeBomLatest) is not a consumer floor, so it leaves the hold above and joins the toolchain group. composeBom stays held.",
      "matchPackageNames": [
        "androidx.compose:compose-bom"
      ],
      "matchJsonata": [
        "sharedVariableName = 'composeBomLatest'"
      ],
      "enabled": true,
      "groupName": "toolchain",
      "addLabels": [
        "toolchain-floor"
      ]
    }
  ]
}
